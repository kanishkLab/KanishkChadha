# Site Configuration
# Copy this file to .env and fill in your values

# Required: Your site URL (used for sitemap, canonical URLs, OG tags)
SITE_URL=https://example.com

# Site language (ISO 639-1 code, e.g., en, id, de, fr, es, ja, zh)
SITE_LANGUAGE=en

# Personal Information
SITE_AUTHOR_NAME="Your Name"
SITE_AUTHOR_TITLE="Senior Software Engineer"
SITE_AUTHOR_BIO="Engineering leader focused on solving complex technical challenges through thoughtful architecture and pragmatic trade-off analysis."
SITE_AUTHOR_EMAIL=hello@example.com
SITE_AUTHOR_LOCATION="San Francisco, CA"

# Homepage portrait. Leave empty to use the optimised src/assets/kanishk.jpeg.
# Set only to override with a different image URL.
SITE_AUTHOR_PORTRAIT=

# Social Links (leave empty to hide)
SOCIAL_GITHUB=https://github.com/username
SOCIAL_LINKEDIN=https://linkedin.com/in/username
SOCIAL_TWITTER=https://twitter.com/username
SOCIAL_MASTODON=
SOCIAL_BLUESKY=

# Site Metadata
SITE_TITLE="Professional Portfolio"
SITE_DESCRIPTION="Engineering leader specializing in system architecture, technical decision-making, and delivering measurable business impact."

# Contact form (Formspree endpoint, e.g. https://formspree.io/f/xyzabc)
FORMSPREE_ENDPOINT=

# Résumé download. Leave empty and drop the PDF at public/resume.pdf — the hero
# button appears automatically once the file exists, and stays hidden while it
# does not (it used to 404). Set this only to point somewhere else, e.g. a
# Drive link or a per-role variant.
SITE_RESUME_URL=

# Newsletter — the "Automated Marketer" signup.
# Posts to Formspree until a real ESP is chosen. Leave this empty and it uses
# FORMSPREE_ENDPOINT above, so signups land in the same inbox as contact
# messages (and count against the same monthly quota — Formspree's free tier
# is 50 submissions/month total). Set it to a second Formspree form to keep
# them separate. While both are empty, no signup form is rendered at all.
NEWSLETTER_FORMSPREE_ENDPOINT=
# Optional: a public newsletter URL, shown as a plain link when no endpoint is set.
NEWSLETTER_URL=
