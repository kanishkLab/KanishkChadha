---
import { siteConfig } from '../config';

/* An empty endpoint used to fall through to `action="mailto:…"` with
   method="POST". Browsers do not send form posts to mailto: — Chrome silently
   does nothing at all — so every message typed into this form was discarded
   with no error shown to the sender. The form now refuses to pretend: with no
   endpoint configured it renders as a direct email card instead of a dead
   submit button. Set FORMSPREE_ENDPOINT in .env to switch it on. */
const endpoint = import.meta.env.FORMSPREE_ENDPOINT || '';
const email = siteConfig.author.email;
---

{endpoint ? (
  <form
    class="contact-form"
    method="POST"
    action={endpoint}
    data-contact-form
    data-endpoint={endpoint}
    data-email={email}
  >
    <div class="form-row">
      <div class="form-field">
        <label for="contact-name">Name</label>
        <input type="text" id="contact-name" name="name" required placeholder="Your name" autocomplete="name" />
      </div>
      <div class="form-field">
        <label for="contact-email">Email</label>
        <input type="email" id="contact-email" name="email" required placeholder="you@example.com" autocomplete="email" />
      </div>
    </div>
    <div class="form-field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" required rows="4" placeholder="Tell me about your project or role..."></textarea>
    </div>
    {/* Formspree reads _subject for the notification subject line, and uses the
        `email` field above as the reply-to automatically. */}
    <input type="hidden" name="_subject" value="New message from kanishkchadha.com" />
    <button type="submit" class="form-submit">Send Message</button>
    <p class="form-success" data-form-success hidden role="status">Thanks for reaching out — I'll get back to you soon.</p>
    <p class="form-error" data-form-error hidden role="alert">
      That didn't send. Email me directly at <a href={`mailto:${email}`}>{email}</a>.
    </p>
  </form>
) : (
  <div class="contact-form contact-form--direct">
    <p class="direct-label">Email</p>
    <a class="direct-address" href={`mailto:${email}?subject=${encodeURIComponent('Hello from kanishkchadha.com')}`}>{email}</a>
    <p class="direct-note">
      The quickest way to reach me — I read everything and reply personally.
    </p>
  </div>
)}

<script>
  function initContactForm() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form => {
      if ((form as any).__contactBound) return;
      (form as any).__contactBound = true;

      const endpoint = form.dataset.endpoint;
      // No endpoint means the direct-email card rendered instead of a form,
      // so there is nothing to bind. Never leave a live submit button that
      // posts nowhere.
      if (!endpoint) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('.form-submit') as HTMLButtonElement;
        const success = form.querySelector('[data-form-success]') as HTMLElement;
        const error = form.querySelector('[data-form-error]') as HTMLElement;
        const origText = btn.textContent;
        btn.textContent = 'Sending…';
        btn.disabled = true;
        error.hidden = true;

        // A failed send must say so. Silently re-enabling the button reads as
        // "sent" to the person who just typed a message.
        const fail = () => {
          error.hidden = false;
          btn.textContent = origText;
          btn.disabled = false;
        };

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' },
          });

          if (res.ok) {
            form.reset();
            success.hidden = false;
            btn.textContent = 'Sent!';
            setTimeout(() => {
              btn.textContent = origText;
              btn.disabled = false;
              success.hidden = true;
            }, 5000);
          } else {
            fail();
          }
        } catch {
          fail();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  /* Card treatment comes from the shared --card-* scale in global.css, so this
     matches the featured work cards, the /projects grid, and the .contact-right
     wrapper this same form sits in on /projects.
     Width is 540px so the 2rem padding leaves the fields at their old 480px. */
  .contact-form {
    /* width:100% is load-bearing. In a grid parent (the homepage contact
       section) `margin: 0 auto` overrides the default stretch alignment, so
       without an explicit width the form shrinks to max-content — 278px once
       the fields stack under 480px — instead of filling the column. */
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    padding: 2rem;
    text-align: left;
    /* This form sits in a grid column on three different pages and is often
       far narrower than the window, so its internal layout has to respond to
       its own width rather than the viewport. See the @container rule below. */
    container-type: inline-size;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    box-shadow: var(--card-shadow);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    margin-bottom: 1rem;
  }

  .form-field label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-signal-orange);
    margin-bottom: 0.375rem;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-navy);
    /* Faintly recessed against the raised card, then lifting to pure white on
       focus — so the active field is the brightest thing in the form. */
    background: #fbfcfc;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color 150ms ease, box-shadow 150ms ease, background 150ms ease;
    box-sizing: border-box;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #9aa6ab;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    background: var(--color-white);
    border-color: var(--color-signal-orange);
    box-shadow: 0 0 0 3px rgba(255, 110, 66, 0.12);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.875rem 2rem;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-signal-orange);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    /* No shadow: the card is the raised object, and every other button on the
       site (.btn, the newsletter submit) is flat. */
    transition: background 150ms ease, transform 150ms ease;
  }

  .form-submit:hover {
    background: #ed5a2e;
    transform: translateY(-1px);
  }

  .form-submit:active {
    transform: translateY(0);
  }

  .form-submit:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 3px;
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .form-success {
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-top: 1rem;
  }

  .form-error {
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: #b3311a;
    margin-top: 1rem;
  }
  .form-error a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Direct-email fallback ─────────────────────────────────
     Shown in place of the form when FORMSPREE_ENDPOINT is unset. Same card
     shell so the page composition is unchanged — only the contents differ. */
  .contact-form--direct {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .direct-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-signal-orange);
    margin-bottom: 0.5rem;
  }

  .direct-address {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 2px solid var(--color-signal-orange);
    padding-bottom: 2px;
    /* Long addresses must not push the card wider than its column. */
    max-width: 100%;
    overflow-wrap: anywhere;
    transition: color 150ms ease;
  }
  .direct-address:hover { color: var(--color-signal-orange); }
  .direct-address:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 3px;
  }

  .direct-note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #4A5A60;
  }

  @media (max-width: 480px) {
    .direct-address { font-size: 1.125rem; }
  }

  /* Stack name/email on the FORM's width, not the viewport. A viewport query
     can't see that the form is squeezed into a narrow grid column: at a 700px
     window the homepage column left the form 312px wide and these two fields
     were sharing it at 115px each, while `max-width: 480px` never matched.

     The threshold is on the form's CONTENT box, which inline-size containment
     measures — not its border box. 400px keeps each field at least ~190px
     before they stack; the form's content box tops out at 476px (540 less the
     2rem padding), so anything near 480 here would stack at every width. */
  @container (max-width: 400px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  /* Padding stays a viewport query — an element can't be styled by the
     container it establishes. */
  @media (max-width: 480px) {
    .contact-form {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-submit,
    .form-field input,
    .form-field textarea {
      transition: none;
    }

    .form-submit:hover,
    .form-submit:active {
      transform: none;
    }
  }
</style>
