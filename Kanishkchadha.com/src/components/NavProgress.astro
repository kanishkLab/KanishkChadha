---
/**
 * Navigation progress bar.
 *
 * `<ClientRouter />` turns every link click into a fetch + DOM swap rather than
 * a browser document navigation, so the tab throbber never appears — there is
 * no document load for the browser to report. This puts that feedback back.
 *
 * It is deliberately hard to see. `prefetch: { prefetchAll: true }` means most
 * pages are already in cache when you click, so navigation resolves in a few
 * milliseconds; a bar that flashed on every one of those would be noise, and a
 * bar that appeared for 3 frames looks broken. So nothing renders until a
 * navigation has actually been waiting for SHOW_DELAY_MS. On a warm local site
 * you should almost never see it. On a cold cache or a slow connection — the
 * only times it is useful — it shows up.
 *
 * Lifecycle: the bar starts on `astro:before-preparation` and completes on
 * `astro:after-preparation`, i.e. it tracks *loading*, and is finished before
 * the view transition starts animating. Tying it to `astro:page-load` instead
 * would leave it on screen during the 540ms transition, long after the thing
 * it was reporting had finished.
 */
---

<div id="kc-progress" class="kc-progress" aria-hidden="true" transition:persist>
  <div class="kc-progress-bar" id="kc-progress-bar"></div>
</div>

<script>
  // The document survives view-transition navigations, so these listeners are
  // bound once for the life of the tab. Without the guard, every navigation
  // would stack another set.
  if (!(window as any).__kcProgressBound) {
    (window as any).__kcProgressBound = true;

    /** Wait this long before showing anything. Below this, navigation is
     *  effectively instant and a bar would only flicker. */
    const SHOW_DELAY_MS = 180;
    /** Give up and hide if a navigation never reports finishing. */
    const SAFETY_MS = 12000;

    let showTimer: number | undefined;
    let creepTimer: number | undefined;
    let safetyTimer: number | undefined;
    let hideTimer: number | undefined;
    let visible = false;
    /* done() is deliberately wired to two events, so it must be idempotent.
       Without this flag the second call's clear() cancelled the hide timer the
       first call had just scheduled, and the bar stayed on screen at 100%. */
    let finishing = false;
    let progress = 0;

    const el = () => document.getElementById('kc-progress');
    const bar = () => document.getElementById('kc-progress-bar');

    function paint() {
      const b = bar();
      if (b) b.style.width = progress + '%';
    }

    function reveal() {
      const c = el();
      if (!c) return;
      visible = true;
      progress = 12;
      paint();
      c.classList.add('kc-progress--on');

      // Creep toward 90% but never reach it — the remaining distance is what
      // makes the final jump to 100% read as completion. Each tick closes a
      // fraction of the gap, so it decelerates on its own.
      creepTimer = window.setInterval(() => {
        progress += (90 - progress) * 0.14;
        if (progress > 89.5) progress = 89.5;
        paint();
      }, 220);
    }

    function start() {
      clear();
      // A new navigation during a fade-out takes over cleanly.
      finishing = false;
      visible = false;
      showTimer = window.setTimeout(reveal, SHOW_DELAY_MS);
      safetyTimer = window.setTimeout(done, SAFETY_MS);
    }

    function clear() {
      window.clearTimeout(showTimer);
      window.clearInterval(creepTimer);
      window.clearTimeout(safetyTimer);
      window.clearTimeout(hideTimer);
    }

    function done() {
      // A hide is already in flight from the earlier event — let it finish.
      if (finishing) return;

      clear();

      // Never shown: the navigation beat SHOW_DELAY_MS, which is the common
      // case. Leave the DOM untouched so nothing flashes.
      if (!visible) {
        progress = 0;
        return;
      }

      const c = el();
      visible = false;
      finishing = true;
      progress = 100;
      paint();

      hideTimer = window.setTimeout(() => {
        c?.classList.remove('kc-progress--on');
        // Reset only once the fade-out has finished, or the bar visibly
        // rewinds to zero on its way out.
        hideTimer = window.setTimeout(() => {
          progress = 0;
          const b = bar();
          if (b) {
            b.style.transition = 'none';
            b.style.width = '0%';
            void b.offsetWidth;      // flush, so the next run animates again
            b.style.transition = '';
          }
          finishing = false;
        }, 200);
      }, 160);
    }

    document.addEventListener('astro:before-preparation', start);
    // Content is loaded here — this is the moment loading actually ends.
    document.addEventListener('astro:after-preparation', done);
    // Backstop: if a navigation is served entirely from cache some flows can
    // skip straight past after-preparation.
    document.addEventListener('astro:page-load', done);
  }
</script>

<style>
  .kc-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    /* Above the nav drawer (200) and its overlay (199), so a navigation
       started from the mobile drawer is still visible. */
    z-index: 300;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .kc-progress--on {
    opacity: 1;
  }

  .kc-progress-bar {
    height: 100%;
    width: 0;
    background: var(--color-signal-orange);
    /* Reads as a light source rather than a drawn line, and keeps the 2px bar
       visible against both the white nav and the navy hero. */
    box-shadow: 0 0 10px rgba(255, 110, 66, 0.7);
    transition: width 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Kept out of the page cross-fade for the same reason as the header: it is
     chrome, not content, and should not fade with the body. */
  .kc-progress {
    view-transition-name: kc-progress;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Deliberately still shown. These users have the page transition disabled
       entirely, so this bar is the only feedback that a navigation happened —
       it just moves without easing. */
    .kc-progress { transition: none; }
    .kc-progress-bar {
      transition: none;
      box-shadow: none;
    }
  }
</style>
