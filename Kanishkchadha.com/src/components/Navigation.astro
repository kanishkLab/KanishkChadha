---
import { siteConfig } from '../config';

const currentPath = Astro.url.pathname;

const navItems = siteConfig.nav;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<!-- ── Desktop nav ─────────────────────────────────────────── -->
<header class="nav-bar">
  <nav class="site-nav" aria-label="Main navigation">

    <!-- KC Monogram / Wordmark -->
    <a href="/" class="nav-brand" aria-label="Kanishk Chadha home">
      <span class="monogram">K<span class="monogram-c">C</span></span>
      <span class="wordmark">Kanishk Chadha</span>
    </a>

    <!-- Desktop links -->
    <div class="nav-scroll">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-end">
      <!-- Mobile hamburger -->
      <button class="hamburger" id="nav-open" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </nav>
</header>

<!-- ── Drawer overlay ─────────────────────────────────────── -->
<div class="drawer-overlay" id="drawer-overlay" aria-hidden="true"></div>

<div class="drawer" id="nav-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <div class="drawer-header">
    <a href="/" class="drawer-brand">
      <span class="monogram monogram--sm">K<span class="monogram-c">C</span></span>
    </a>
    <button class="drawer-close" id="nav-close" aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <p class="drawer-label">Explore</p>

  <ul class="drawer-list">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['drawer-link', { 'drawer-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span>{item.label}</span>
          <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  function initDrawer() {
    const openBtn  = document.getElementById('nav-open');
    const closeBtn = document.getElementById('nav-close');
    const drawer   = document.getElementById('nav-drawer');
    const overlay  = document.getElementById('drawer-overlay');

    // The header carries transition:persist, so these nodes survive
    // navigation while astro:page-load fires again on every one.
    // Without this guard each navigation stacks another set of
    // listeners on the same buttons.
    if (openBtn?.dataset.drawerBound === 'true') return;
    if (openBtn) openBtn.dataset.drawerBound = 'true';

    /* Scroll lock.
       `body { overflow: hidden }` did not hold — the page scrolled freely
       behind the open drawer (measured: 400px -> 1000px with the drawer up),
       and on iOS Safari that approach never works. Pinning the body with
       position:fixed at a negative offset is the technique that does, but it
       resets scroll to the top, so the offset is stashed and restored on
       close. */
    let lockedY = 0;

    function open() {
      // Re-entering open() while already open would read scrollY as 0 (the
      // body is pinned), so the stashed offset would be lost and closing
      // would dump the reader at the top of the page.
      if (drawer?.classList.contains('drawer--open')) return;
      lockedY = window.scrollY;
      drawer?.classList.add('drawer--open');
      overlay?.classList.add('drawer-overlay--visible');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }
    /* Closing normally runs a 300ms slide. When the click is also a
       navigation, the router starts a view transition immediately and
       snapshots the header — drawer included — mid-slide, then holds that
       frozen image for the length of the page transition before swapping it
       out. That is the drawer appearing to stick on screen and then vanish.
       Skipping the slide means it is fully gone before the snapshot is taken. */
    function closeInstantly() {
      if (!drawer) return close();
      drawer.style.transition = 'none';
      close();
      void drawer.offsetWidth;          // flush, so the next open still animates
      requestAnimationFrame(() => { if (drawer) drawer.style.transition = ''; });
    }

    function close() {
      // Guard so a stray close() (Escape with the drawer already shut) can't
      // yank the page back to a stale offset.
      const wasOpen = drawer?.classList.contains('drawer--open');
      drawer?.classList.remove('drawer--open');
      overlay?.classList.remove('drawer-overlay--visible');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      if (wasOpen) {
        // instant, not smooth — this is restoring where the reader already
        // was, not travelling somewhere new.
        window.scrollTo({ top: lockedY, behavior: 'instant' as ScrollBehavior });
      }
    }

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    overlay?.addEventListener('click', close);
    drawer?.querySelectorAll('.drawer-link').forEach(l =>
      l.addEventListener('click', () => {
        const href = l.getAttribute('href') || '';
        // Same-page anchors don't navigate, so they keep the normal slide.
        const navigates = !href.startsWith('#');
        navigates ? closeInstantly() : close();
      })
    );
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  }

  function updateActiveNav() {
    const path = window.location.pathname;
    document.querySelectorAll('.nav-link').forEach(link => {
      const href = link.getAttribute('href');
      const active = href === '/' ? path === '/' : href ? path.startsWith(href) : false;
      link.classList.toggle('nav-link--active', active);
      active ? link.setAttribute('aria-current', 'page') : link.removeAttribute('aria-current');
    });
    document.querySelectorAll('.drawer-link').forEach(link => {
      const href = link.getAttribute('href');
      const active = href === '/' ? path === '/' : href ? path.startsWith(href) : false;
      link.classList.toggle('drawer-link--active', active);
      active ? link.setAttribute('aria-current', 'page') : link.removeAttribute('aria-current');
    });
  }

  function initHashScroll() {
    document.querySelectorAll('.nav-link, .drawer-link').forEach(link => {
      const href = link.getAttribute('href');
      if (!href || !href.includes('#')) return;

      link.addEventListener('click', (e) => {
        const [path, hash] = href.split('#');
        const onTargetPage = !path ? true : path === '/' ? window.location.pathname === '/' : window.location.pathname.startsWith(path);

        if (!onTargetPage) return;   // let the browser navigate

        const target = document.getElementById(hash);

        /* The Contact nav item is a bare "#contact", so this branch used to be
           taken on every page — including blog posts, which are the one page
           type with no contact section. There the target was null, the click
           was already preventDefault-ed, and tapping Contact did precisely
           nothing. Fall back to the homepage anchor when the section isn't
           on this page. */
        if (!target) {
          window.location.href = `/#${hash}`;
          e.preventDefault();
          return;
        }

        e.preventDefault();
        // The drawer's close() restores scroll synchronously; defer a frame so
        // this smooth scroll starts from the restored position rather than
        // being cancelled by it.
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth' });
          // Keep the URL honest so the anchor is shareable and Back works.
          history.replaceState(null, '', `#${hash}`);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initDrawer();
    updateActiveNav();
    initHashScroll();
  });
</script>

<style>
  /* ── Nav bar — full-width white strip ──────────────────────────────── */
  .nav-bar {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Nav shell — content-aligned ───────────────────────────────────
     1200 minus a 40px gutter leaves a 1120px content edge, which is the
     width every designed page runs to. Keep these two numbers in step with
     the page containers or the nav visibly changes width between pages. */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    height: 64px;
  }

  /* ── KC lockup ─────────────────────────────────────────── */
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: 2rem;
    flex-shrink: 0;
    text-decoration: none;
  }

  .monogram {
    font-family: var(--font-family);
    font-weight: 800;
    font-size: 2.25rem;
    color: var(--color-navy);
    letter-spacing: -0.08em;
    line-height: 1;
    display: inline-flex;
    transition: opacity 150ms ease;
  }
  .nav-brand:hover .monogram,
  .nav-brand:hover .wordmark { opacity: 0.7; }

  .monogram--sm { font-size: 1.25rem; }

  .monogram-c { color: var(--color-signal-orange); }

  .wordmark {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    line-height: 1;
    transition: opacity 150ms ease;
  }

  /* ── Desktop links ───────────────────────────────────────── */
  .nav-scroll {
    margin-left: auto;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .nav-scroll::-webkit-scrollbar { display: none; }

  .nav-list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: max-content;
    height: 56px;
    align-items: center;
  }

  .nav-item { margin: 0; }

  .nav-link {
    display: flex;
    align-items: center;
    height: 56px;
    padding: 0 1rem;
    font-family: var(--font-family);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy);
    text-decoration: none;
    transition: color 150ms ease;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
  }
  .nav-link:hover { color: var(--color-signal-orange); }
  .nav-link--active {
    color: var(--color-signal-orange);
    border-bottom-color: var(--color-signal-orange);
  }

  /* ── Nav end ─────────────────────────────────────────────── */
  /* Desktop: nav-end holds only the hidden hamburger, so it must not
     consume width — the last link's text has to flush with the content edge. */
  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .nav-scroll { margin-right: -1rem; }

  /* ── Hamburger ───────────────────────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    border-radius: var(--border-radius-sm);
    transition: background 150ms ease;
  }
  .hamburger:hover { background: rgba(0,0,0,0.05); }
  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-navy);
    border-radius: 2px;
  }

  /* ── Drawer overlay ──────────────────────────────────────── */
  .drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 199;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .drawer-overlay--visible { display: block; opacity: 1; }

  /* ── Drawer panel ────────────────────────────────────────── */
  .drawer {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: min(280px, 80vw);
    background: var(--color-navy);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .drawer--open { transform: translateX(0); }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drawer-brand { text-decoration: none; }

  /* .monogram is navy for the white header bar, and the drawer's background is
     that same navy — so inside the drawer the "K" was navy-on-navy and simply
     did not exist, leaving a lone orange "C". The "C" kept its accent colour,
     which is why this read as a missing glyph rather than a missing logo. */
  .drawer-brand .monogram { color: #ffffff; }

  .drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(255,255,255,0.5);
    padding: 4px;
    border-radius: var(--border-radius-sm);
    display: flex;
    align-items: center;
    transition: color 150ms ease;
  }
  .drawer-close:hover { color: #ffffff; }

  .drawer-label {
    font-family: var(--font-family);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.3);
    padding: 1rem 1.25rem 0.5rem;
    margin: 0;
  }

  .drawer-list { list-style: none; margin: 0; padding: 0; }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    font-family: var(--font-family);
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 150ms ease, background 150ms ease;
  }
  .drawer-link:hover {
    color: #ffffff;
    background: rgba(255,255,255,0.05);
  }
  .drawer-link--active { color: var(--color-signal-orange); }
  .drawer-link--active .chevron { opacity: 0.8; }

  .chevron { flex-shrink: 0; opacity: 0.3; transition: opacity 150ms ease; }
  .drawer-link:hover .chevron { opacity: 0.6; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .nav-scroll { display: none; }
    .hamburger  { display: flex; }

    .nav-brand { margin-right: auto; }
  }

  /* Gutter switches at 760px to stay in step with the page containers,
     which is a different breakpoint from the hamburger above. */
  @media (max-width: 760px) {
    .site-nav { padding: 0 24px; }
  }

  /* Below ~360px the lockup drops to the mark only */
  @media (max-width: 360px) {
    .wordmark { display: none; }
  }
</style>
