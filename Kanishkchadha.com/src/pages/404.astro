---
import { siteConfig } from '../config';

const pageTitle = '404 - Page Not Found';
---

<!DOCTYPE html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    
    <!-- Inline critical styles -->
    <style>
      /* This page is standalone (no BaseLayout), so the Nautical
         tokens are inlined rather than imported — a 404 should
         render even if the stylesheet request is the thing that
         failed. Values mirror src/styles/global.css. */
      :root {
        --color-bg: #f9f9f9;
        --color-navy: #092634;
        --color-text: #092634;
        --color-text-secondary: #3a4a52;
        --color-text-muted: #6b7c85;
        --color-accent: #ff6e42;
        --color-accent-hover: #f0592c;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        letter-spacing: -0.01em;
        -webkit-font-smoothing: antialiased;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }

      .container {
        max-width: 500px;
        width: 100%;
        text-align: center;
      }

      .icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 2rem;
        color: var(--color-text-muted);
        opacity: 0.6;
      }

      .error-code {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--color-accent);
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2.25rem;
        line-height: 1.15;
        font-weight: 700;
        letter-spacing: -0.035em;
        margin-bottom: 1rem;
        color: var(--color-text);
      }

      .description {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
      }

      .home-button {
        display: inline-block;
        padding: 0.875rem 2rem;
        background: var(--color-accent);
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9375rem;
        letter-spacing: -0.01em;
        text-decoration: none;
        border-radius: 10px;
        transition: background 150ms ease;
      }

      .home-button:hover {
        background: var(--color-accent-hover);
      }

      @media (max-width: 640px) {
        .icon {
          width: 64px;
          height: 64px;
          margin-bottom: 1.5rem;
        }

        .error-code {
          font-size: 0.875rem;
        }

        h1 {
          font-size: 1.5rem;
        }

        .description {
          font-size: 1rem;
          margin-bottom: 2rem;
        }

        .home-button {
          padding: 0.75rem 1.75rem;
          font-size: 0.9375rem;
        }
      }
    </style>

    <!-- Theme initialization script -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <!-- 404 Icon -->
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>

      <div class="error-code">404 Error</div>
      
      <h1>Page Not Found</h1>
      
      <p class="description">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>

      <a href="/" class="home-button">Back to Home</a>
    </div>
  </body>
</html>
