---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.draft === false;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const postId = slug || '';

const post = await getEntry('blog', postId);

if (!post) {
  return Astro.redirect('/404');
}

const { Content, headings } = await render(post);

const {
  title,
  description,
  publishDate,
  updatedDate,
  tags,
  type,
  context,
  decision,
  alternatives,
  reasoning,
  event,
  eventUrl,
  location,
  talkType,
  slides,
  video,
  duration,
  topics,
} = post.data;

const readingTime = getReadingTime(post.body || '');

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}

const typeLabel = type === 'experiment' ? 'Experiment' : type === 'tool-verdict' ? 'Tool Verdict' : type === 'decision' ? 'Decision' : 'Talk';
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - Blog`}
    description={description}
    type="article"
    publishDate={publishDate}
    updatedDate={updatedDate}
  />

  <StructuredData
    type="Article"
    data={{
      title,
      description,
      publishDate,
      updatedDate,
      tags,
      url: Astro.url.href,
    }}
  />

  <main class="article">
    <header class="article-header">
      <div class="article-type-badge">{typeLabel}</div>
      <h1>{title}</h1>
      <div class="article-meta">
        <time class="publish-date" datetime={publishDate.toISOString()}>
          {formatDate(publishDate)}
        </time>
        <span class="meta-separator">·</span>
        <span class="reading-time">{readingTime}</span>
        {updatedDate && (
          <>
            <span class="meta-separator">·</span>
            <time class="updated-date" datetime={updatedDate.toISOString()}>
              Updated {formatDate(updatedDate)}
            </time>
          </>
        )}
      </div>
      {tags && tags.length > 0 && (
        <div class="article-tags">
          {tags.map((tag) => (
            <a href={`/blog/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    {/* Decision-specific section */}
    {type === 'decision' && (
      <div class="decision-section">
        {context && (
          <div class="decision-block">
            <h2>Context</h2>
            <p>{context}</p>
          </div>
        )}
        {decision && (
          <div class="decision-block">
            <h2>Decision</h2>
            <p>{decision}</p>
          </div>
        )}
        {alternatives && alternatives.length > 0 && (
          <div class="decision-block">
            <h2>Alternatives Considered</h2>
            <ul class="alternatives-list">
              {alternatives.map((alt) => (
                <li>
                  <strong>{alt.option}</strong>
                  {alt.pros && (
                    <div class="pros">
                      <strong>Pros:</strong>
                      <ul>
                        {alt.pros.map((pro) => <li>{pro}</li>)}
                      </ul>
                    </div>
                  )}
                  {alt.cons && (
                    <div class="cons">
                      <strong>Cons:</strong>
                      <ul>
                        {alt.cons.map((con) => <li>{con}</li>)}
                      </ul>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
        {reasoning && (
          <div class="decision-block">
            <h2>Reasoning</h2>
            <p>{reasoning}</p>
          </div>
        )}
      </div>
    )}

    {/* Talk-specific section */}
    {type === 'talk' && (
      <div class="talk-section">
        {event && (
          <div class="talk-meta-item">
            <strong>Event:</strong>
            {eventUrl ? (
              <a href={eventUrl} target="_blank" rel="noopener noreferrer">{event}</a>
            ) : (
              <span>{event}</span>
            )}
          </div>
        )}
        {location && (
          <div class="talk-meta-item">
            <strong>Location:</strong> {location}
          </div>
        )}
        {talkType && (
          <div class="talk-meta-item">
            <strong>Type:</strong> {talkType.charAt(0).toUpperCase() + talkType.slice(1)}
          </div>
        )}
        {duration && (
          <div class="talk-meta-item">
            <strong>Duration:</strong> {duration}
          </div>
        )}
        {(slides || video) && (
          <div class="talk-links">
            {slides && (
              <a href={slides} class="talk-link" target="_blank" rel="noopener noreferrer">
                → View Slides
              </a>
            )}
            {video && (
              <a href={video} class="talk-link" target="_blank" rel="noopener noreferrer">
                → Watch Video
              </a>
            )}
          </div>
        )}
        {topics && topics.length > 0 && (
          <div class="talk-topics">
            <strong>Topics:</strong>
            <ul>
              {topics.map((topic) => <li>{topic}</li>)}
            </ul>
          </div>
        )}
      </div>
    )}

    {/* Table of Contents */}
    <TableOfContents headings={headings} />

    {/* Article Content */}
    <article class="article-content">
      <Content />
    </article>

    <BackLink href="/blog" text="All posts" />
  </main>

  <ScrollToTop />

  <style>
    .article {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .article-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    .article-type-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.375rem 0.75rem;
      background: var(--color-signal-orange);
      color: #ffffff;
      border-radius: 4px;
      margin-bottom: 1rem;
    }

    .article-header h1 {
      /* Was 40px/700 — two steps off the 52px/600 h1 on /blog that links here. */
      font-size: 3.25rem;
      margin-bottom: 1rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.04;
      color: var(--color-text);
    }

    .article-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
      margin-bottom: 1rem;
    }

    .meta-separator {
      opacity: 0.5;
    }

    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .tag {
      font-size: 0.8125rem;
      padding: 0.25rem 0.75rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 4px;
      color: var(--color-signal-orange);
      text-decoration: none;
      transition: all 150ms ease;
    }

    .tag:hover {
      border-color: var(--color-signal-orange);
      background: rgba(255, 107, 53, 0.05);
    }

    /* Decision-specific styles */
    .decision-section {
      background: var(--color-bg-secondary);
      padding: 2rem;
      border-radius: 8px;
      margin-bottom: 2rem;
      border-left: 4px solid var(--color-signal-orange);
    }

    .decision-block {
      margin-bottom: 2rem;
    }

    .decision-block:last-child {
      margin-bottom: 0;
    }

    .decision-block h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: var(--color-text);
    }

    .decision-block p {
      margin: 0;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .alternatives-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .alternatives-list li {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: var(--color-bg);
      border-radius: 6px;
      border-left: 3px solid var(--color-border);
    }

    .alternatives-list strong {
      color: var(--color-text);
    }

    .pros, .cons {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
    }

    .pros strong, .cons strong {
      display: block;
      color: var(--color-text);
      margin-bottom: 0.5rem;
    }

    .pros ul, .cons ul {
      margin: 0;
      padding-left: 1.5rem;
      color: var(--color-text-secondary);
    }

    /* Talk-specific styles */
    .talk-section {
      background: var(--color-bg-secondary);
      padding: 2rem;
      border-radius: 8px;
      margin-bottom: 2rem;
      border-left: 4px solid var(--color-signal-orange);
    }

    .talk-meta-item {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1rem;
      font-size: 0.9375rem;
    }

    .talk-meta-item strong {
      color: var(--color-text);
      min-width: 80px;
    }

    .talk-meta-item a {
      color: var(--color-signal-orange);
      text-decoration: none;
    }

    .talk-meta-item a:hover {
      text-decoration: underline;
    }

    .talk-links {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    .talk-link {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-signal-orange);
      text-decoration: none;
      transition: all 150ms ease;
    }

    .talk-link:hover {
      transform: translateX(4px);
    }

    .talk-topics {
      margin-top: 1.5rem;
    }

    .talk-topics strong {
      display: block;
      color: var(--color-text);
      margin-bottom: 0.75rem;
    }

    .talk-topics ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .talk-topics li {
      padding: 0.25rem 0.75rem;
      background: var(--color-bg);
      border-radius: 4px;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
    }

    /* Article content styles */
    .article-content {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text);
      margin-bottom: 3rem;
    }

    .article-content :global(h2) {
      font-size: 2.125rem;
      margin-top: 2.25rem;
      margin-bottom: 0.875rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: var(--color-text);
    }

    .article-content :global(h3) {
      font-size: 1.3125rem;
      margin-top: 1.75rem;
      margin-bottom: 0.625rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      line-height: 1.4;
      color: var(--color-text);
    }

    .article-content :global(h4) {
      font-size: 1.125rem;
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      font-weight: 600;
      line-height: 1.5;
      color: var(--color-text);
    }

    .article-content :global(p) {
      margin-bottom: 1.5rem;
      color: var(--color-text-secondary);
    }

    .article-content :global(ul),
    .article-content :global(ol) {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: var(--color-text-secondary);
    }

    .article-content :global(li) {
      margin-bottom: 0.5rem;
      line-height: 1.7;
    }

    .article-content :global(blockquote) {
      margin: 2rem 0;
      padding: 1rem 1.5rem;
      border-left: 4px solid var(--color-accent);
      background: var(--color-bg-secondary);
      font-style: italic;
      color: var(--color-text-secondary);
    }

    .article-content :global(code) {
      font-family: var(--font-mono);
      font-size: 0.9em;
      background: var(--color-bg-secondary);
      padding: 0.2em 0.4em;
      border-radius: 3px;
      color: var(--color-text);
    }

    .article-content :global(pre) {
      margin: 2rem 0;
      padding: 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      overflow-x: auto;
    }

    .article-content :global(pre code) {
      background: none;
      padding: 0;
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .article-content :global(a) {
      color: var(--color-signal-orange);
      text-decoration: none;
      transition: all 150ms ease;
    }

    .article-content :global(a:hover) {
      text-decoration: underline;
    }

    .article-content :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 2rem 0;
    }

    .article-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      font-size: 0.9375rem;
    }

    .article-content :global(th) {
      background: var(--color-bg-secondary);
      padding: 0.75rem;
      text-align: left;
      font-weight: 600;
      border-bottom: 2px solid var(--color-border);
    }

    .article-content :global(td) {
      padding: 0.75rem;
      border-bottom: 1px solid var(--color-border);
    }

    .article-content :global(tr:hover) {
      background: var(--color-bg-secondary);
    }
  
    /* ── Responsive ──────────────────────────────────────────
       This template previously had no media queries at all. Once the h1 was
       raised to 52px to match /blog, that size persisted onto phones and
       pushed the page wider than the viewport at 320px. */
    @media (max-width: 768px) {
      .article-header h1 {
        font-size: 2.25rem;   /* 36px — same as .page-h1 on /blog */
        line-height: 1.1;
      }

      .article-content :global(h2) {
        font-size: 1.75rem;
        margin-top: 2rem;
      }

      .article-content :global(h3) {
        font-size: 1.25rem;
      }

      .article-content {
        font-size: 1.0625rem;
      }
    }
  </style>
</BaseLayout>
