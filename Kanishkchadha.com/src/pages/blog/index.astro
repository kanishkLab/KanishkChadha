---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../../pages.config';
import ContactForm from '../../components/ContactForm.astro';

const allPosts = await getCollection('blog', ({ data }) => data.draft === false);

const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featuredPost = sortedPosts[0];

const TYPE_LABELS: Record<string, string> = {
  experiment: 'Experiment',
  'tool-verdict': 'Tool Verdict',
  decision: 'Decision',
  talk: 'Talk',
};

/* Only offer a chip for a type that actually has posts — an empty filter is
   a dead end, and tool-verdict currently has none. */
const typesPresent = [...new Set(sortedPosts.map(p => p.data.type))];
const allFilters = ['All', ...typesPresent];
const filterCounts: Record<string, number> = { All: sortedPosts.length };
for (const p of sortedPosts) {
  filterCounts[p.data.type] = (filterCounts[p.data.type] || 0) + 1;
}

const years = sortedPosts.map(p => p.data.publishDate.getFullYear());
const yearRange = years.length
  ? (Math.min(...years) === Math.max(...years)
      ? `${years[0]}`
      : `${Math.min(...years)}–${Math.max(...years)}`)
  : '';
const experimentCount = filterCounts['experiment'] || 0;

const fmtShort = (d: Date) =>
  d.toLocaleDateString('en-CA', { month: 'short', year: 'numeric' });
const fmtLong = (d: Date) =>
  d.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout>
  <SEO
    slot="head"
    title={pagesConfig.blog.title}
    description={pagesConfig.blog.description}
    type="website"
  />

  <div class="lab-page kc-page">

    <!-- Page header -->
    <header class="page-header">
      <div class="header-inner">
        <p class="eyebrow">The Lab</p>
        <h1 class="page-h1">Experiments, in the open.</h1>
        <p class="page-lead">{pagesConfig.blog.intro}</p>
        <div class="meta-rule">
          <span>{sortedPosts.length} posts{yearRange && `, ${yearRange}`}</span>
          <span class="meta-dot"></span>
          <span>{experimentCount} run with real data</span>
        </div>
      </div>
    </header>

    <!-- Sticky filter bar -->
    <div class="filter-sticky" id="filter-bar">
      <div class="filter-inner">
        <div class="filter-chips" role="tablist" aria-label="Filter posts by type">
          {allFilters.map((f, i) => (
            <button
              class:list={['chip', { 'chip--active': i === 0 }]}
              data-filter={f}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {f === 'All' ? 'All' : TYPE_LABELS[f]}<span class="chip-count">{filterCounts[f]}</span>
            </button>
          ))}
        </div>
        <div class="result-count" aria-live="polite">
          {sortedPosts.length} posts
        </div>
      </div>
    </div>

    <!-- Post band -->
    <section class="case-band">
      <div class="band-inner">

        {featuredPost && (
          <article class="featured" id="featured-panel" data-type={featuredPost.data.type}>
            <div class="featured-plate">
              <div class="plate-eyebrow">Lab note</div>
              <div class="plate-rows">
                {featuredPost.data.tags.filter(t => t !== 'blog').slice(0, 5).map((t: string) => (
                  <div class="plate-row">
                    <span class="plate-dash"></span>
                    <span>{t}</span>
                  </div>
                ))}
              </div>
              <div class="plate-footnote">
                {TYPE_LABELS[featuredPost.data.type]} &middot; {fmtLong(featuredPost.data.publishDate)}
              </div>
            </div>
            <div class="featured-text">
              <div class="featured-meta">
                <span class="tag-latest">Latest</span>
                <span class="featured-eyebrow">
                  {TYPE_LABELS[featuredPost.data.type]} &middot; {fmtShort(featuredPost.data.publishDate)}
                </span>
              </div>
              <h2 class="featured-h2">{featuredPost.data.title}</h2>
              <p class="featured-body">{featuredPost.data.description}</p>
              <div class="stack-pills">
                {featuredPost.data.tags.filter(t => t !== 'blog').slice(0, 4).map((t: string) => (
                  <span class="pill">{t}</span>
                ))}
              </div>
              <div class="featured-cta">
                <a href={`/blog/${featuredPost.id}`} class="btn-primary">Read the post &rarr;</a>
              </div>
            </div>
          </article>
        )}

        <!-- Post grid -->
        <div class="card-grid" id="card-grid">
          {sortedPosts.map((post, idx) => (
            <a
              href={`/blog/${post.id}`}
              class:list={['card', { 'card--featured-hidden': idx === 0 }]}
              data-type={post.data.type}
              data-idx={idx}
            >
              {post.data.coverImage && (
                <div class="card-media">
                  <img src={post.data.coverImage} alt={post.data.title} class="card-img" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <p class="card-eyebrow">{TYPE_LABELS[post.data.type].toUpperCase()}</p>
                <h3 class="card-h3">{post.data.title}</h3>
                <p class="card-desc">{post.data.description}</p>
                <div class="stack-pills stack-pills--card">
                  {post.data.tags.filter(t => t !== 'blog').slice(0, 3).map((t: string) => (
                    <span class="pill">{t}</span>
                  ))}
                </div>
              </div>
              <div class="card-footer">
                <span class="card-cta-text">Read the post &rarr;</span>
                <span class="card-year">{fmtShort(post.data.publishDate)}</span>
              </div>
            </a>
          ))}
        </div>

        {sortedPosts.length === 0 && (
          <p class="empty-state">Nothing published yet — the first experiments are being written up.</p>
        )}

        <!-- Newsletter strip -->
        <aside class="lab-strip">
          <div class="strip-tile">AM</div>
          <div class="strip-content">
            <h3 class="strip-title">Automated Marketer</h3>
            <p class="strip-body">Every experiment here goes out first as a weekly note on using AI, analytics and automation in real campaigns.</p>
          </div>
          <a href="/#newsletter" class="btn-ghost-dark">Subscribe &rarr;</a>
        </aside>

      </div>
    </section>

    <!-- Contact section -->
    <section id="contact" class="contact-section">
      <div class="contact-grid">
        <div class="contact-left">
          <p class="eyebrow">Get in touch</p>
          <h2 class="contact-h2">Own your tracking, CDP, and the agents on top of it.</h2>
          <p class="contact-body">That's the job I do. Tell me what you're building and where the measurement breaks down.</p>
          <div class="availability-line">
            <span class="availability-dot"></span>
            <span>Open to Martech, Marketing Analytics, and Marketing Ops roles in Calgary and remote.</span>
          </div>
        </div>
        <div class="contact-right">
          <ContactForm />
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  function initLabFilters() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.lab-page .chip');
    const featured = document.getElementById('featured-panel');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.lab-page .card');
    const resultCount = document.querySelector('.lab-page .result-count');

    if (chips.length === 0) return;
    if ((chips[0] as HTMLElement).dataset.filterBound === 'true') return;
    (chips[0] as HTMLElement).dataset.filterBound = 'true';

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter!;

        chips.forEach(c => {
          c.classList.remove('chip--active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('chip--active');
        chip.setAttribute('aria-selected', 'true');

        const isAll = filter === 'All';

        // The featured post is also the first card; it only shows as a panel
        // on "All", and rejoins the grid once a filter narrows the set.
        if (featured) {
          featured.style.display = isAll ? '' : 'none';
        }

        let count = 0;
        cards.forEach(card => {
          const type = card.dataset.type;
          const idx = parseInt(card.dataset.idx || '0', 10);
          const matches = isAll || type === filter;
          const hiddenAsFeatured = isAll && idx === 0;

          // card--featured-hidden is a build-time class so the featured post
          // isn't duplicated before JS runs. It has to be toggled here too --
          // clearing the inline display alone leaves the class still hiding it.
          if (matches && !hiddenAsFeatured) {
            card.classList.remove('card--featured-hidden', 'card--hidden');
            card.style.display = '';
          } else if (hiddenAsFeatured) {
            card.classList.add('card--featured-hidden', 'card--hidden');
            card.style.display = 'none';
          } else {
            card.classList.add('card--hidden');
            setTimeout(() => { card.style.display = 'none'; }, 150);
          }

          if (matches) count++;
        });

        if (resultCount) {
          resultCount.textContent = count + (count === 1 ? ' post' : ' posts');
        }
      });
    });

    // Initial state: the featured post is shown as the panel, not in the grid.
    cards.forEach(card => {
      if (parseInt(card.dataset.idx || '0', 10) === 0) {
        card.style.display = 'none';
        card.classList.add('card--hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', initLabFilters);
</script>

<style>
  /* Palette, type stack and nav alignment come from .kc-page in global.css,
     shared with /projects. Layout below mirrors that page so the two index
     pages read as one system. */

  /* ── Eyebrow (reused) ──────────────────────────────────── */
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: var(--kc-accent);
    margin: 0 0 14px;
  }

  /* ── Page header ───────────────────────────────────────── */
  .page-header {
    padding: 56px 40px 36px;
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.04;
    margin: 0;
    color: var(--kc-ink);
    max-width: 16ch;
    text-wrap: pretty;
  }

  .page-lead {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--kc-body);
    margin: 20px 0 0;
    max-width: 54ch;
    text-wrap: pretty;
  }

  .meta-rule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--kc-line);
    font-size: 13px;
    font-weight: 600;
    color: var(--kc-body-2);
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--kc-line);
    flex: none;
  }

  /* ── Filter bar (sticky) ───────────────────────────────── */
  .filter-sticky {
    position: sticky;
    top: 65px;
    z-index: 30;
    background: rgba(255,255,255,.96);
    border-bottom: 1px solid var(--kc-line);
  }

  .filter-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    padding: 10px 15px;
    border-radius: 999px;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
    background: var(--kc-white);
    color: var(--kc-ink);
    border: 1px solid var(--kc-line);
    white-space: nowrap;
  }

  .chip:hover { border-color: var(--kc-ink); }

  .chip--active {
    background: var(--kc-ink);
    color: var(--kc-white);
    border-color: var(--kc-ink);
  }

  .chip-count {
    opacity: .55;
    margin-left: 7px;
  }

  .result-count {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--kc-muted);
    white-space: nowrap;
  }

  /* ── Post band ─────────────────────────────────────────── */
  .case-band {
    background: var(--kc-surface);
    border-bottom: 1px solid var(--kc-line);
    padding: 56px 40px 72px;
  }

  .band-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  /* ── Featured panel ────────────────────────────────────── */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    border: 1px solid var(--kc-line);
    border-radius: var(--card-radius);
    overflow: hidden;
    box-shadow: var(--kc-shadow-raised);
    background: var(--kc-white);
  }

  /* Plate side — the counterpart to the diagram on /projects. Built from the
     post's own tags rather than decoration, so it says something true. */
  .featured-plate {
    background: var(--kc-ink-2);
    background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.03) 0 2px, transparent 2px 22px);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
  }

  .plate-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--kc-accent);
  }

  .plate-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .plate-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 600;
    color: rgba(255,255,255,.9);
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,.09);
  }

  .plate-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .plate-dash {
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--kc-accent);
    flex: none;
  }

  .plate-footnote {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,.45);
    margin-top: 4px;
  }

  /* Text side */
  .featured-text {
    padding: 44px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .tag-latest {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    background: var(--kc-accent);
    color: #fff;
    padding: 6px 12px;
    border-radius: 6px;
  }

  .featured-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--kc-ocean);
  }

  .featured-h2 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.14;
    margin: 0;
    color: var(--kc-ink);
    text-wrap: pretty;
  }

  .featured-body {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--kc-body);
    margin: 0;
    max-width: 52ch;
    text-wrap: pretty;
  }

  /* Pills (shared with /projects) */
  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .stack-pills--card {
    margin-top: auto;
    padding-top: 8px;
  }

  .pill {
    font-size: 12px;
    font-weight: 600;
    color: var(--kc-ocean);
    background: var(--kc-surface-2);
    border-radius: 6px;
    padding: 6px 10px;
  }

  .featured-cta { margin-top: 8px; }

  .btn-primary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: var(--kc-accent);
    padding: 13px 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: background .15s;
  }

  .btn-primary:hover {
    background: var(--kc-accent-hover);
    text-decoration: none;
  }

  /* ── Post grid ─────────────────────────────────────────── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--kc-white);
    border: 1px solid var(--kc-line);
    border-radius: var(--card-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--kc-shadow-soft);
    transition: box-shadow .15s;
  }

  .card:hover {
    box-shadow: var(--kc-shadow-raised);
    text-decoration: none;
  }

  .card--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .card--featured-hidden { display: none; }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--kc-ink);
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 24px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .14em;
    color: var(--kc-accent);
    margin: 0;
  }

  .card-h3 {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.2;
    margin: 0;
    color: var(--kc-ink);
    text-wrap: pretty;
  }

  /* Clamped: post descriptions vary a lot in length, and without this the
     cards in a row pull to wildly different heights. */
  .card-desc {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--kc-body);
    margin: 0;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: 18px;
    padding: 14px 24px 18px;
    border-top: 1px solid var(--kc-line-2);
    font-size: 13px;
    font-weight: 700;
    color: var(--kc-accent);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-year {
    color: var(--kc-muted);
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    color: var(--kc-body-2);
    font-size: 15px;
    font-weight: 500;
    padding: 40px 0;
    margin: 0;
  }

  /* ── Newsletter strip ──────────────────────────────────── */
  .lab-strip {
    background: var(--kc-ocean);
    border-radius: var(--card-radius);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 26px;
    box-shadow: var(--kc-shadow-soft);
  }

  .strip-tile {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: var(--kc-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-logo);
    font-weight: 800;
    font-size: 18px;
    color: #fff;
    letter-spacing: -.04em;
  }

  .strip-content {
    flex: 1;
    min-width: 0;
  }

  .strip-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -.02em;
    margin: 0;
    color: #fff;
  }

  .strip-body {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255,255,255,.88);
    margin: 6px 0 0;
    max-width: 62ch;
  }

  .btn-ghost-dark {
    flex: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: rgba(255,255,255,.1);
    border: 1px solid rgba(255,255,255,.2);
    padding: 13px 24px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: background .15s;
  }

  .btn-ghost-dark:hover {
    background: rgba(255,255,255,.16);
    text-decoration: none;
  }

  /* ── Contact section ───────────────────────────────────── */
  .contact-section {
    padding: 80px 40px;
  }

  .contact-grid {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-left .eyebrow { margin-bottom: 14px; }

  .contact-h2 {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.1;
    margin: 0;
    color: var(--kc-ink);
    max-width: 20ch;
    text-wrap: pretty;
  }

  .contact-body {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--kc-body);
    margin: 18px 0 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .availability-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--kc-line);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--kc-body-2);
  }

  .availability-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--kc-accent);
    flex: none;
  }

  .contact-right {
    background: var(--kc-white);
    border: 1px solid var(--kc-line);
    border-radius: var(--card-radius);
    padding: 32px;
    box-shadow: var(--kc-shadow-soft);
  }

  /* .contact-right is already the card, so strip the elevation the component
     carries for the centred layouts — same as /projects. */
  .contact-right :global(.contact-form) {
    max-width: none;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
    box-shadow: none;
  }

  .contact-right :global(.form-field label) {
    font-size: 12px;
