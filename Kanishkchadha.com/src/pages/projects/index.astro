---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../../pages.config';
import { siteConfig } from '../../config';
import ContactForm from '../../components/ContactForm.astro';

const allProjects = await getCollection('projects');

const sortedProjects = allProjects.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  if (a.data.order !== undefined) return -1;
  if (b.data.order !== undefined) return 1;
  return b.data.year - a.data.year;
});

const featuredProject = sortedProjects[0];
const allCategories = ['All', ...new Set(sortedProjects.map(p => p.data.role))];
const categoryCounts: Record<string, number> = { All: sortedProjects.length };
for (const p of sortedProjects) {
  categoryCounts[p.data.role] = (categoryCounts[p.data.role] || 0) + 1;
}

const ongoingCount = sortedProjects.filter(p => p.data.status === 'ongoing').length;
const linkedin = siteConfig.social.linkedin;
---

<BaseLayout>
  <SEO
    slot="head"
    title={pagesConfig.projects.title}
    description={pagesConfig.projects.description}
    type="website"
  />

  <div class="projects-page kc-page">

    <!-- Page header -->
    <header class="page-header">
      <div class="header-inner">
        <p class="eyebrow">Selected work</p>
        <h1 class="page-h1">All case studies.</h1>
        <p class="page-lead">How I approach a marketing problem — diagnosing the constraint, choosing the channel mix, building the AI-powered system, and measuring what actually moved the needle.</p>
        <div class="meta-rule">
          <span>{sortedProjects.length} systems, 2023–2024</span>
          <span class="meta-dot"></span>
          <span>{ongoingCount} still running today</span>
        </div>
      </div>
    </header>

    <!-- Sticky filter bar -->
    <div class="filter-sticky" id="filter-bar">
      <div class="filter-inner">
        <div class="filter-chips" role="tablist" aria-label="Filter projects by category">
          {allCategories.map((cat, i) => (
            <button
              class:list={['chip', { 'chip--active': i === 0 }]}
              data-filter={cat}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {cat}<span class="chip-count">{categoryCounts[cat]}</span>
            </button>
          ))}
        </div>
        <div class="result-count" aria-live="polite">
          {sortedProjects.length} case studies
        </div>
      </div>
    </div>

    <!-- Case study band -->
    <section class="case-band">
      <div class="band-inner">

        <!-- Featured panel (only on "All" filter) -->
        <article class="featured" id="featured-panel" data-role={featuredProject.data.role}>
          <div class="featured-diagram">
            <div class="diagram-eyebrow">Lead qualification flow</div>
            <div class="diagram-row-2">
              <div class="diagram-node">Inbound form</div>
              <div class="diagram-node">Enrichment</div>
            </div>
            <div class="diagram-arrows"><span>&#8595;</span><span>&#8595;</span></div>
            <div class="diagram-agent">
              <div class="agent-title">Qualify + score agent</div>
              <div class="agent-sub">n8n &middot; Make &middot; Anthropic &middot; OpenAI</div>
              <div class="agent-bar">
                <div class="bar-track"><div class="bar-fill"></div></div>
                <span class="bar-score">0.92</span>
              </div>
            </div>
            <div class="diagram-arrows"><span>&#8595;</span><span>&#8595;</span></div>
            <div class="diagram-row-2">
              <div class="diagram-node">CRM record</div>
              <div class="diagram-node diagram-node--accent">Eval suite</div>
            </div>
            <div class="diagram-footnote">Every run scored before it reaches a rep.</div>
          </div>
          <div class="featured-text">
            <div class="featured-meta">
              {featuredProject.data.status === 'ongoing' && <span class="tag-ongoing">Ongoing</span>}
              <span class="featured-eyebrow">Flagship &middot; {featuredProject.data.role} &middot; {featuredProject.data.year}</span>
            </div>
            <h2 class="featured-h2">{featuredProject.data.title}</h2>
            <p class="featured-body">{featuredProject.data.outcomeSummary}</p>
            {featuredProject.data.outcomeHighlight && (
              <div class="outcome-line">
                <span class="outcome-dot"></span>
                <span class="outcome-text">{featuredProject.data.outcomeHighlight}</span>
              </div>
            )}
            <div class="stack-pills">
              {featuredProject.data.techStack.slice(0, 4).map((t: string) => (
                <span class="pill">{t}</span>
              ))}
              {featuredProject.data.techStack.length > 4 && (
                <span class="pill-more">+{featuredProject.data.techStack.length - 4}</span>
              )}
            </div>
            <div class="featured-cta">
              <a href={`/projects/${featuredProject.id}`} class="btn-primary">Read the case study &rarr;</a>
            </div>
          </div>
        </article>

        <!-- Card grid -->
        <div class="card-grid" id="card-grid">
          {sortedProjects.map((project, idx) => (
            <a
              href={`/projects/${project.id}`}
              class:list={['card', { 'card--featured-hidden': idx === 0 }]}
              data-role={project.data.role}
              data-idx={idx}
            >
              <div class="card-media">
                {project.data.coverImage ? (
                  <img src={project.data.coverImage} alt={project.data.title} class="card-img" loading="lazy" />
                ) : (
                  <div class="card-img card-img--placeholder" />
                )}
                {project.data.status === 'ongoing' && (
                  <span class="card-tag-ongoing">Ongoing</span>
                )}
              </div>
              <div class="card-body">
                <p class="card-eyebrow">{project.data.role.toUpperCase()}</p>
                <h3 class="card-h3">{project.data.title}</h3>
                <p class="card-desc">{project.data.outcomeSummary}</p>
                {project.data.outcomeHighlight && (
                  <div class="card-outcome">
                    <span class="outcome-dot"></span>
                    <span>{project.data.outcomeHighlight}</span>
                  </div>
                )}
                <div class="stack-pills stack-pills--card">
                  {project.data.techStack.slice(0, 4).map((t: string) => (
                    <span class="pill">{t}</span>
                  ))}
                  {project.data.techStack.length > 4 && (
                    <span class="pill-more">+{project.data.techStack.length - 4}</span>
                  )}
                </div>
              </div>
              <div class="card-footer">
                <span class="card-cta-text">View case study &rarr;</span>
                <span class="card-year">{project.data.year}</span>
              </div>
            </a>
          ))}
        </div>

        <!-- LinkedIn strip -->
        {linkedin && (
          <aside class="linkedin-strip">
            <div class="li-tile">in</div>
            <div class="li-content">
              <h3 class="li-title">What colleagues & clients say</h3>
              <p class="li-body">Recommendations from people I've worked with — on collaboration, delivery, and impact.</p>
            </div>
            <a href={`${linkedin}/details/recommendations/`} target="_blank" rel="noopener noreferrer" class="btn-ghost-dark">Read on LinkedIn &rarr;</a>
          </aside>
        )}

      </div>
    </section>

    <!-- Contact section -->
    <section id="contact" class="contact-section">
      <div class="contact-grid">
        <div class="contact-left">
          <p class="eyebrow">Get in touch</p>
          <h2 class="contact-h2">Own your tracking, CDP, and the agents on top of it.</h2>
          <p class="contact-body">That's the job I do. Tell me what you're building and where the measurement breaks down.</p>
          <div class="availability-line">
            <span class="availability-dot"></span>
            <span>Open to Martech, Marketing Analytics, and Marketing Ops roles in Calgary and remote.</span>
          </div>
        </div>
        <div class="contact-right">
          <ContactForm />
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  function initProjectFilters() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const featured = document.getElementById('featured-panel');
    const cards = document.querySelectorAll<HTMLAnchorElement>('.card');
    const resultCount = document.querySelector('.result-count');

    if (chips.length === 0) return;
    if ((chips[0] as HTMLElement).dataset.filterBound === 'true') return;
    (chips[0] as HTMLElement).dataset.filterBound = 'true';

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter!;

        chips.forEach(c => {
          c.classList.remove('chip--active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('chip--active');
        chip.setAttribute('aria-selected', 'true');

        const isAll = filter === 'All';

        if (featured) {
          featured.style.display = isAll ? '' : 'none';
        }

        let count = 0;
        cards.forEach(card => {
          const role = card.dataset.role;
          const idx = parseInt(card.dataset.idx || '0', 10);
          const matches = isAll || role === filter;
          const hiddenAsFeatured = isAll && idx === 0;

          // card--featured-hidden is a build-time class so the featured project
          // isn't duplicated before JS runs. It has to be toggled here too --
          // clearing the inline display alone leaves the class still hiding it,
          // so the featured project never rejoined the grid under a filter.
          if (matches && !hiddenAsFeatured) {
            card.classList.remove('card--featured-hidden', 'card--hidden');
            card.style.display = '';
          } else if (hiddenAsFeatured) {
            card.classList.add('card--featured-hidden', 'card--hidden');
            card.style.display = 'none';
          } else {
            card.classList.add('card--hidden');
            setTimeout(() => { card.style.display = 'none'; }, 150);
          }

          if (matches) count++;
        });

        if (resultCount) {
          resultCount.textContent = count + (count === 1 ? ' case study' : ' case studies');
        }
      });
    });

    // Initial state: hide featured card from grid on "All"
    cards.forEach(card => {
      if (parseInt(card.dataset.idx || '0', 10) === 0) {
        card.style.display = 'none';
        card.classList.add('card--hidden');
      }
    });
  }

  document.addEventListener('astro:page-load', initProjectFilters);
</script>

<style>
  /* Palette, type stack and nav alignment come from .kc-page in global.css,
     shared with /blog. */

  /* ── Eyebrow (reused) ──────────────────────────────────── */
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .22em;
    color: var(--kc-accent);
    margin: 0 0 14px;
  }

  /* ── Page header ───────────────────────────────────────── */
  .page-header {
    padding: 56px 40px 36px;
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .page-h1 {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1.04;
    margin: 0;
    color: var(--kc-ink);
    max-width: 16ch;
    text-wrap: pretty;
  }

  .page-lead {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--kc-body);
    margin: 20px 0 0;
    max-width: 54ch;
    text-wrap: pretty;
  }

  .meta-rule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--kc-line);
    font-size: 13px;
    font-weight: 600;
    color: var(--kc-body-2);
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--kc-line);
    flex: none;
  }

  /* ── Filter bar (sticky) ───────────────────────────────── */
  .filter-sticky {
    position: sticky;
    top: 65px;
    z-index: 30;
    background: rgba(255,255,255,.96);
    border-bottom: 1px solid var(--kc-line);
  }

  .filter-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    padding: 10px 15px;
    border-radius: 999px;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
    background: var(--kc-white);
    color: var(--kc-ink);
    border: 1px solid var(--kc-line);
    white-space: nowrap;
  }

  .chip:hover {
    border-color: var(--kc-ink);
  }

  .chip--active {
    background: var(--kc-ink);
    color: var(--kc-white);
    border-color: var(--kc-ink);
  }

  .chip-count {
    opacity: .55;
    margin-left: 7px;
  }

  .result-count {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--kc-muted);
    white-space: nowrap;
  }

  /* ── Case-study band ───────────────────────────────────── */
  .case-band {
    background: var(--kc-surface);
    border-bottom: 1px solid var(--kc-line);
    padding: 56px 40px 72px;
  }

  .band-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  /* ── Featured panel ────────────────────────────────────── */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    border: 1px solid var(--kc-line);
    border-radius: var(--card-radius);
    overflow: hidden;
    box-shadow: var(--kc-shadow-raised);
    background: var(--kc-white);
  }

  /* Diagram side */
  .featured-diagram {
    background: var(--kc-ink-2);
    background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.03) 0 2px, transparent 2px 22px);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }

  .diagram-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--kc-accent);
    margin-bottom: 4px;
  }

  .diagram-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .diagram-node {
    border: 1px solid rgba(255,255,255,.2);
    background: rgba(255,255,255,.1);
    border-radius: 10px;
    padding: 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #fff;
    text-align: center;
  }

  .diagram-node--accent {
    border-color: rgba(255,110,66,.5);
    background: transparent;
    color: var(--kc-accent);
  }

  .diagram-arrows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    color: rgba(255,255,255,.5);
    font-size: 16px;
    text-align: center;
    line-height: 1;
  }

  .diagram-agent {
    border: 1px solid rgba(255,110,66,.55);
    background: rgba(255,110,66,.12);
    border-radius: 12px;
    padding: 18px;
  }

  .agent-title {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
  }

  .agent-sub {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,.65);
    margin-top: 6px;
  }

  .agent-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }

  .bar-track {
    flex: 1;
    height: 8px;
    border-radius: 999px;
    background: rgba(255,255,255,.16);
    overflow: hidden;
  }

  .bar-fill {
    width: 78%;
    height: 100%;
    background: var(--kc-accent);
  }

  .bar-score {
    font-size: 12px;
    font-weight: 800;
    color: var(--kc-accent);
  }

  .diagram-footnote {
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,.2);
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,.65);
  }

  /* Text side */
  .featured-text {
    padding: 44px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .tag-ongoing {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    background: var(--kc-accent);
    color: #fff;
    padding: 6px 12px;
    border-radius: 6px;
  }

  .featured-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--kc-ocean);
  }

  .featured-h2 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.14;
    margin: 0;
    color: var(--kc-ink);
    text-wrap: pretty;
  }

  .featured-body {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--kc-body);
    margin: 0;
    max-width: 52ch;
    text-wrap: pretty;
  }

  .outcome-line {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--kc-line);
  }

  .outcome-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--kc-accent);
    flex: none;
  }

  .outcome-text {
    font-size: 13px;
    font-weight: 700;
    color: var(--kc-ink);
    line-height: 1.4;
  }

  /* Stack pills (shared) */
  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .stack-pills--card {
    margin-top: auto;
    padding-top: 8px;
  }

  .pill {
    font-size: 12px;
    font-weight: 600;
    color: var(--kc-ocean);
    background: var(--kc-surface-2);
    border-radius: 6px;
    padding: 6px 10px;
  }

  .pill-more {
    font-size: 12px;
    font-weight: 600;
    color: var(--kc-muted);
    padding: 6px 4px;
  }

  .featured-cta {
    margin-top: 8px;
  }

  .btn-primary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: var(--kc-accent);
    padding: 13px 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: background .15s;
  }

  .btn-primary:hover {
    background: var(--kc-accent-hover);
    text-decoration: none;
  }

  /* ── Card grid ─────────────────────────────────────────── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--kc-white);
    border: 1px solid var(--kc-line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--kc-shadow-soft);
    transition: box-shadow .15s;
  }

  .card:hover {
    box-shadow: var(--kc-shadow-raised);
    text-decoration: none;
  }

  .card--hidden {
    opacity: 0;
    pointer-events: none;
  }

  .card--featured-hidden {
    display: none;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--kc-ink);
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-img--placeholder {
    background: linear-gradient(135deg, #e8ecf0, #d1d8de);
  }

  .card-tag-ongoing {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    background: var(--kc-accent);
    color: #fff;
    padding: 6px 12px;
    border-radius: 6px;
    pointer-events: none;
  }

  .card-body {
    padding: 24px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .14em;
    color: var(--kc-accent);
    margin: 0;
  }

  .card-h3 {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: 1.2;
    margin: 0;
    color: var(--kc-ink);
    text-wrap: pretty;
  }

  .card-desc {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--kc-body);
    margin: 0;
    text-wrap: pretty;
  }

  .card-outcome {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--kc-accent-tint);
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--kc-accent-deep);
    line-height: 1.35;
  }

  .card-footer {
    margin-top: 18px;
    padding: 14px 24px 18px;
    border-top: 1px solid var(--kc-line-2);
    font-size: 13px;
    font-weight: 700;
    color: var(--kc-accent);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-year {
    font-size: 12px;
    font-weight: 600;
    color: var(--kc-muted);
  }

  /* ── LinkedIn strip ────────────────────────────────────── */
  .linkedin-strip {
    background: var(--kc-ocean);
    border-radius: 12px;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 26px;
    box-shadow: var(--kc-shadow-soft);
  }

  .li-tile {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: var(--kc-linkedin);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-logo);
    font-weight: 800;
    font-size: 22px;
    color: #fff;
