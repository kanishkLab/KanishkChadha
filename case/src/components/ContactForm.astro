---
import { siteConfig } from '../config';

const endpoint = import.meta.env.FORMSPREE_ENDPOINT || '';
---

<form
  class="contact-form"
  method="POST"
  action={endpoint || `mailto:${siteConfig.author.email}`}
  data-contact-form
  data-endpoint={endpoint}
>
  <div class="form-row">
    <div class="form-field">
      <label for="contact-name">Name</label>
      <input type="text" id="contact-name" name="name" required placeholder="Your name" autocomplete="name" />
    </div>
    <div class="form-field">
      <label for="contact-email">Email</label>
      <input type="email" id="contact-email" name="email" required placeholder="you@example.com" autocomplete="email" />
    </div>
  </div>
  <div class="form-field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" required rows="4" placeholder="Tell me about your project or role..."></textarea>
  </div>
  <button type="submit" class="form-submit">Send Message</button>
  <p class="form-success" data-form-success hidden>Thanks for reaching out — I'll get back to you soon.</p>
</form>

<script>
  function initContactForm() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form => {
      if ((form as any).__contactBound) return;
      (form as any).__contactBound = true;

      const endpoint = form.dataset.endpoint;
      if (!endpoint) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('.form-submit') as HTMLButtonElement;
        const success = form.querySelector('[data-form-success]') as HTMLElement;
        const origText = btn.textContent;
        btn.textContent = 'Sending…';
        btn.disabled = true;

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' },
          });

          if (res.ok) {
            form.reset();
            success.hidden = false;
            btn.textContent = 'Sent!';
            setTimeout(() => {
              btn.textContent = origText;
              btn.disabled = false;
              success.hidden = true;
            }, 5000);
          } else {
            btn.textContent = origText;
            btn.disabled = false;
          }
        } catch {
          btn.textContent = origText;
          btn.disabled = false;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-form {
    max-width: 480px;
    margin: 0 auto;
    text-align: left;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    margin-bottom: 1rem;
  }

  .form-field label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-signal-orange);
    margin-bottom: 0.375rem;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-navy);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    box-sizing: border-box;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #9aa6ab;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--color-signal-orange);
    box-shadow: 0 0 0 3px rgba(255, 110, 66, 0.1);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.875rem 2rem;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-signal-orange);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 150ms ease, transform 150ms ease;
  }

  .form-submit:hover {
    background: #ed5a2e;
    transform: translateY(-1px);
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .form-success {
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-top: 1rem;
  }

  @media (max-width: 480px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
