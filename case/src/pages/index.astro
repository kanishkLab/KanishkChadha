---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import ContactForm from '../components/ContactForm.astro';

/* ── Featured work ─────────────────────────────────────────
   Three cards. Featured projects lead (by manual order), then the newest
   remaining projects fill the grid. The full set lives on /projects. */
const allProjects = await getCollection('projects');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const others = allProjects
  .filter(p => !p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);
const cases = [...featured, ...others].slice(0, 3);

/* ── The Lab (upcoming — switch to collection query once posts publish) */
const labPosts = [
  { title: 'I built a lead-scoring agent with n8n + Claude — here\'s the eval', type: 'experiment', readTime: 8, date: 'Sep 2026', excerpt: 'A real workflow tested against 200 historical conversions — with the eval spreadsheet.' },
  { title: 'Clay for enrichment: who it\'s actually for', type: 'tool-verdict', readTime: 5, date: 'Aug 2026', excerpt: 'Tried it on two enrichment jobs. One was perfect, the other was a waste of credits.' },
  { title: 'What happens when you pipe Segment events into an AI classifier', type: 'experiment', readTime: 7, date: 'Aug 2026', excerpt: 'Intent scoring from raw event streams — the setup, the surprises, and where it broke.' },
];

/* ── Tech stack ────────────────────────────────────────────
   Logos are self-hosted SVGs (brand colours) in /public/logos. */
const tools = [
  { name: 'HubSpot', slug: 'hubspot' },
  { name: 'Salesforce', slug: 'salesforce' },
  { name: 'Segment', slug: 'segment' },
  { name: 'GA4', slug: 'googleanalytics' },
  { name: 'Google Data Studio', slug: 'googledatastudio' },
  { name: 'Google Ads', slug: 'googleads' },
  { name: 'Meta', slug: 'meta' },
  { name: 'n8n', slug: 'n8n' },
  { name: 'Make', slug: 'make' },
  { name: 'Zapier', slug: 'zapier' },
  { name: 'OpenAI', slug: 'openai' },
  { name: 'Claude', slug: 'anthropic' },
  { name: 'Notion', slug: 'notion' },
  { name: 'Slack', slug: 'slack' },
  { name: 'Power BI', slug: 'powerbi' },
  { name: 'GTM', slug: 'googletagmanager' },
  { name: 'Cookiebot', slug: 'cookiebot' },
  { name: 'Optimizely', slug: 'optimizely' },
  { name: 'Hotjar', slug: 'hotjar' },
  { name: 'Mixpanel', slug: 'mixpanel' },
  { name: 'Clay', slug: 'clay' },
].map(t => ({
  ...t,
  logo: `/logos/${t.slug}.svg`,
}));

const credibilityStats = [
  { value: '9+ yrs', label: 'Owning martech, measurement & reporting' },
  { value: '$250K+', label: 'Paid media managed at 3.8× ROAS' },
  { value: '10+', label: 'Locations / web properties instrumented end-to-end' },
];

const capabilities = [
  {
    num: '01',
    title: 'Automation & AI Systems',
    desc: 'Agentic workflows with tool access, decision loops, and escalation logic — not one-off prompts. Systems that run and self-correct after launch — and I show the eval, not just the workflow — the test cases, expected vs. actual, and the failure modes I found before trusting it with real leads.',
    tags: ['n8n', 'HubSpot', 'Salesforce', 'GPT / Claude'],
  },
  {
    num: '02',
    title: 'Analytics & Attribution',
    desc: 'Full-funnel measurement and reporting so every spend and campaign decision is grounded in real, queryable data.',
    tags: ['SQL', 'GA4', 'Looker Studio', 'Meta / Google Ads', 'Server-side GTM', 'GA4 Measurement Protocol'],
  },
  {
    num: '03',
    title: 'Customer Data / CDP',
    desc: 'Unified customer profiles, event tracking, and audience activation across the stack for clean, real-time segmentation.',
    tags: ['Segment', 'GTM', 'Consent Mode v2', 'Identity resolution'],
  },
  {
    num: '04',
    title: 'AI Enablement & Governance',
    desc: 'Rolling AI out across a marketing team with guardrails, review gates, and documented decision-making that scales safely.',
    tags: ['Prompt Systems', 'Guardrails', 'Enablement', 'Governance'],
  },
];

const timeline = [
  { period: '2024 — Present', role: 'MarTech Partner', org: 'Rohit Group of Companies', desc: 'Building the measurement and AI-agent layer for Alberta’s largest private developer — attribution, CDP, DSP implementation, and agentic automation across master-planned communities in Calgary and Edmonton.' },
  { period: '2021 — 2024', role: 'Data & Analytics Marketing Manager', org: 'Mosaic Home Services', desc: 'Primary measurement advisor across a 10+ location franchise network. Owned attribution, $250K+ paid media at 3.8× ROAS, reporting, and 10+ lead-gen web builds (35% more inbound leads).' },
  { period: '2017 — 2019', role: 'IT Project & Business Analyst', org: 'Virala (Toronto)', desc: 'Translated client requirements into technical specs across 15+ web and mobile builds; bridged analytics, marketing and engineering.' },
  { period: '2014 — 2017', role: 'Digital PM & Marketing Specialist', org: 'Virala (India)', desc: 'Client-facing analytics and campaign partner for Sony, Fitbit, SanDisk and Gold Coast University — measurement, reporting and channel optimization across SEO, SEM and programmatic.' },
];


const { portrait, name: authorName, title: authorTitle } = siteConfig.author;
const linkedin = siteConfig.social.linkedin;
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${authorName} — ${authorTitle}`}
    description={siteConfig.description}
    type="website"
    noSuffix
  />

  {/* Playfair Display + Manrope are the brand-guidelines type system and
      are used on this page only, so they load here rather than in
      BaseLayout — internal pages stay on the single-family Inter setup.
      Inter itself is already loaded globally for the logo lockup. */}
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
  />

  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <div class="home">

    <!-- ── 1. HERO ──────────────────────────────────────── -->
    <section class="hero-band">
      <div class="wrap sec hero">
      <div>
        <p class="overline">AI &nbsp;·&nbsp; Analytics &nbsp;·&nbsp; Automation</p>
        <h1 class="hero-title">I don't just run campaigns. I build the data layer marketing runs on — and the AI agents that act on it.</h1>
        <p class="hero-sub">
          I'm Kanishk — a martech and analytics builder with 9+ years across real estate,
          home services and agency. I build tracking, CDP, lifecycle and reporting systems,
          and the AI agents that work on top of them, so growth keeps compounding after launch.
        </p>
        <div class="btn-row">
          <a class="btn btn-orange" href="#cases">See the work</a>
          {/* TODO: résumé PDF — user wants three variants (Martech, Analytics, Ops). Add PDFs to public/ and convert this to a dropdown or three links. */}
          <a class="btn btn-navy" href={siteConfig.resumeUrl}>Download Résumé ↓</a>
        </div>
      </div>


      <div class="portrait">
        {portrait
          ? <img src={portrait} alt={`${authorName}, ${authorTitle}`} width="800" height="1000" />
          : <div class="portrait-ph" aria-hidden="true"><span>KC</span></div>}

      </div>
      </div>
    </section>

    <!-- ── 2. TECH STACK ────────────────────────────────── -->
    <section id="stack" class="band band-white">
      <div class="wrap stack-inner">
        <p class="band-label">The Stack I Work In</p>
        <ul class="tools">
          {tools.map(t => (
            <li class="tool">
              <span class="tool-mark">
                <img src={t.logo} alt="" width="18" height="18" loading="lazy" />
              </span>
              <span class="tool-name">{t.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── 3. CREDIBILITY STRIP ─────────────────────────── -->
    <section class="band band-navy">
      <div class="wrap sec cred">
        <div>
          <p class="overline">9+ Years in Martech & Analytics</p>
          <h2 class="cred-statement">Senior enough to be trusted with the stack — and the outcomes.</h2>
          <p class="cred-trusted">Real estate · home services · technology — from Alberta's largest private developer to a 10+ location franchise network.</p>
        </div>
        <div class="cred-stats">
          {credibilityStats.map(s => (
            <div>
              <div class="cred-value">{s.value}</div>
              <div class="cred-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 4. CAPABILITIES ──────────────────────────────── -->
    <section id="skills" class="wrap sec block">
      <div class="sec-head">
        <p class="overline">Capabilities</p>
        <h2 class="h2">What I bring to a senior martech team</h2>
        <p class="sec-lede">
          Four clusters, mapped to how martech and marketing-ops roles are scoped —
          so you can check it against the JD fast.
        </p>
      </div>
      <div class="matrix">
        {capabilities.map(c => (
          <div class="matrix-row">
            <div class="matrix-main">
              <span class="matrix-num">{c.num}</span>
              <div>
                <h3 class="matrix-title">{c.title}</h3>
                <p class="matrix-desc">{c.desc}</p>
              </div>
            </div>
            <div class="matrix-tags">
              {c.tags.map(tag => <span class="matrix-tag">{tag}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 5. FEATURED WORK ─────────────────────────────── -->
    <section id="cases" class="wrap sec block">
      <div class="sec-head sec-head--tight">
        <p class="overline">Featured Work</p>
        <h2 class="h2">Outcomes, not project names</h2>
      </div>

      {cases.length > 0 && (
        <div class="case-grid">
          {cases.map(project => (
            <a class="case" href={`/projects/${project.id}`}>
              <div class="case-media">
                {project.data.coverImage
                  ? <img class="case-img" src={project.data.coverImage} alt="" loading="lazy" />
                  : <div class="case-img case-ph" aria-hidden="true"></div>}
              </div>
              <div class="case-body">
                <span class="case-category">{project.data.role}</span>
                <h3 class="case-title">{project.data.title}</h3>
                <p class="case-outcome">{project.data.outcomeSummary}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- ── 6. EXPERIENCE ────────────────────────────────── -->
    <section id="experience" class="wrap sec block">
      <div class="timeline-wrap">
        <div class="sec-head sec-head--tight">
          <p class="overline">Experience</p>
          <h2 class="h2 h2--sm">The path so far</h2>
        </div>
        <div class="timeline">
          {timeline.map(t => (
            <div class="timeline-row">
              <span class="timeline-period">{t.period}</span>
              <div>
                <div class="timeline-role">{t.role} <span class="timeline-org">· {t.org}</span></div>
                <p class="timeline-desc">{t.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 7. NEWSLETTER ────────────────────────────────── -->
    <section class="wrap sec block">
      <div id="newsletter" class="newsletter">
        <div class="newsletter-media">
          <img src="/images/newsletter-desk.jpg" alt="" loading="lazy" width="1400" height="933" />
        </div>
        <div class="newsletter-body">
          <p class="overline">The Newsletter</p>
          <p class="newsletter-title">Automated Marketer</p>
          <p class="newsletter-sub">
            A weekly note on using AI, analytics and automation in real campaigns.
            Build smarter, measure better, automate with intention.
          </p>
          <form class="newsletter-form" method="post" action="#">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input id="newsletter-email" name="email" type="email" required placeholder="your@email.com" />
            <button type="submit">Subscribe</button>
          </form>
        </div>
      </div>
    </section>

    <!-- ── 8. LINKEDIN ──────────────────────────────────── -->
    <section class="wrap sec linkedin-sec">
      <div class="linkedin">
        <span class="linkedin-tile" aria-hidden="true">in</span>
        <div class="linkedin-copy">
          <div class="linkedin-title">Let's connect on LinkedIn</div>
          <p class="linkedin-desc">
            I share tracking teardowns, AI-agent experiments, and the occasional
            "here's what actually moved the number."
          </p>
        </div>
        <a class="btn btn-teal" href={linkedin || '#'} target="_blank" rel="noopener noreferrer">Follow →</a>
      </div>
    </section>

    <!-- ── 9. THE LAB ───────────────────────────────────── -->
    <section id="lab" class="wrap sec block">
      <div class="lab-head">
        <div>
          <p class="overline">The Lab</p>
          <h2 class="h2 h2--sm">Experiments & tool verdicts</h2>
        </div>
        <a class="link-all" href="/blog">View all →</a>
      </div>
      <div class="lab-list">
        {labPosts.map((post) => (
          <div class="lab-row">
            <span class:list={['lab-badge', { 'lab-badge--verdict': post.type === 'tool-verdict' }]}>{post.type === 'tool-verdict' ? 'Tool Verdict' : post.type === 'experiment' ? 'Experiment' : post.type === 'decision' ? 'Decision' : 'Talk'}</span>
            <div class="lab-content">
              <h3 class="lab-title">{post.title}</h3>
              {post.excerpt && <p class="lab-excerpt">{post.excerpt}</p>}
            </div>
            <span class="lab-meta">{post.readTime} min · {post.date}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 10. CONTACT ──────────────────────────────────── -->
    <section id="contact" class="wrap sec contact">
      <h2 class="h2 h2--lg">Get in touch</h2>
      <p class="contact-lede">
        Looking for someone who can own your tracking, CDP, reporting and the
        AI agents on top of it? That's the job I do.
      </p>
      <div class="contact-layout">
        <div class="contact-visual">
          <img src="/images/contact-conversation.jpg" alt="" loading="lazy" width="1400" height="933" />
        </div>
        <ContactForm />
      </div>
      <p class="availability">Currently open to Martech, Marketing Analytics, and Marketing Ops roles in Calgary (and remote).</p>
    </section>

  </div>
</BaseLayout>

<style>
  /* ── Nautical brand v1.0 — Playfair + Manrope ─────────────
     Tokens from design_handoff_brand_guidelines/. Type system:
     Playfair Display 600 for headings/display, Manrope for body
     and UI, Inter reserved for the logo lockup.
     Usage ratio white 60 / navy 25 / blue 10 / orange 5 — so the
     page ground is White and off-white is a tinted panel surface.
  ──────────────────────────────────────────────────────────── */
  .home {
    --navy: #092634;
    --teal: #004e72;
    --orange: #ff6e42;
    --orange-hover: #ed5a2e;    /* darken ~8% */
    --navy-hover: #0d3346;      /* lighten ~10% */
    --smoke: #f9f9f9;           /* tinted panel / hero surface */
    --slate: #3a4a52;           /* body grey (darkened for contrast) */
    --slate-muted: #556670;     /* secondary body / caption (darkened) */
    --label: #9aa6ab;           /* overlines & footers on light */
    --hairline: #e6e9ea;

    --font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --font-ui: 'Manrope', system-ui, -apple-system, sans-serif;
    --font-logo: 'Inter', system-ui, -apple-system, sans-serif;

    background: #ffffff;
    color: var(--navy);
    font-family: var(--font-ui);
    font-weight: 500;
    letter-spacing: normal;     /* Manrope sets its own; no Inter tracking */
    -webkit-font-smoothing: antialiased;
  }

  /* Visible focus ring, per the guide's interaction notes */
  .home a:focus-visible,
  .home button:focus-visible,
  .home input:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }

  /* 1200 minus the 40px gutter gives the same 1120px content edge as the nav
     and as /projects and /blog. Changing either number desyncs this page from
     the header. */
  .wrap { max-width: 1200px; margin-inline: auto; }
  .sec  { padding-inline: 40px; }
  .block { padding-top: 72px; }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── Shared type ────────────────────────────────────────── */
  .overline {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--orange);
    margin: 0 0 10px;
  }

  .h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 34px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--navy);
    margin: 0;
  }
  .h2--sm { font-size: 30px; }
  .h2--lg { font-size: 40px; }

  .sec-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 38px;
  }
  .sec-head--tight { margin-bottom: 34px; }
  .sec-lede {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--slate);
    margin: 12px 0 0;
  }

  /* ── Buttons ────────────────────────────────────────────── */
  .btn {
    display: inline-block;
    font-family: var(--font-ui);
    padding: 13px 26px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: normal;
    text-decoration: none;
    color: #fff;
    transition: background 150ms ease, transform 150ms ease;
  }
  .btn:hover { transform: translateY(-1px); color: #fff; }
  .btn-orange { background: var(--orange); }
  .btn-orange:hover { background: var(--orange-hover); }
  .btn-navy { background: var(--navy); }
  .btn-navy:hover { background: var(--navy-hover); }
  .btn-teal { background: var(--teal); white-space: nowrap; }
  .btn-teal:hover { background: #063d59; }

  /* ── 1. Hero ────────────────────────────────────────────── */
  /* The guide's off-white "hero body surface" is a bordered card on a
     white page, not a full-bleed band — run full width it reads as the
     page being grey. The hero sits on white; discrete panels below
     carry the off-white tint. */
  .hero-band { background: #ffffff; }
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 60px;
  }
  .hero .overline { font-size: 13px; margin-bottom: 24px; }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--navy);
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .hero-sub {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.65;
    color: var(--slate);
    max-width: 540px;
    margin: 6px 0 30px;
    text-wrap: pretty;
  }
  .btn-row { display: flex; flex-wrap: wrap; gap: 14px; }

  .availability {
    margin: 22px 0 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--slate-muted);
  }

  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    box-shadow: 0 4px 18px rgba(9, 38, 52, 0.12);
    overflow: hidden;
    background: #eef1f2;
  }
  .portrait img,
  .portrait-ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait-ph {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--navy) 0%, #0a3a50 100%);
  }
  .portrait-ph span {
    font-family: var(--font-logo);
    font-size: 96px;
    font-weight: 800;
    letter-spacing: -0.08em;
    color: rgba(255, 255, 255, 0.12);
  }

  /* ── 2. Tech stack ──────────────────────────────────────── */
  .band-white {
    background: #ffffff;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .stack-inner { padding: 34px 40px; }

  .band-label {
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--slate-muted);
    margin: 0 0 22px;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .tool {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 15px;
    background: var(--smoke);
    border: 1px solid var(--hairline);
    border-radius: 8px;
  }
  .tool-mark {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tool-mark img { width: 18px; height: 18px; object-fit: contain; display: block; }
  .tool-name { font-size: 14px; font-weight: 600; color: var(--navy); }

  /* ── 3. Credibility strip ───────────────────────────────── */
  .band-navy { background: var(--navy); }
  .cred {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px;
    align-items: center;
    padding-top: 44px;
    padding-bottom: 44px;
  }
  .cred .overline { margin-bottom: 12px; }
  .cred-statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 12px;
  }
  .cred-trusted {
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }
  .cred-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .cred-value {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cred-label {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 5px;
  }

  /* ── 4. Capabilities matrix ─────────────────────────────── */
  .matrix {
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
  }
  .matrix-row {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 36px;
    align-items: center;
    padding: 26px 30px;
    border-bottom: 1px solid var(--hairline);
  }
  .matrix-row:last-child { border-bottom: none; }

  .matrix-main { display: flex; gap: 18px; align-items: baseline; }
  .matrix-num {
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.02em;
    color: var(--orange);
    flex-shrink: 0;
  }
  .matrix-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
    color: var(--navy);
    margin: 0 0 6px;
  }
