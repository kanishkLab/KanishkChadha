---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
  }));
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug!);

if (!project) {
  return Astro.redirect('/404');
}

const { Content } = await render(project);

const {
  title,
  role,
  year,
  duration,
  teamSize,
  outcomeSummary,
  overview,
  problem,
  constraints,
  approach,
  keyDecisions,
  techStack,
  impact,
  learnings,
  relatedProjects,
  relatedDecisions,
  coverImage,
  status,
} = project.data;

const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
};
const statusInfo = statusConfig[status || 'completed'];

const allText = [
  overview,
  problem,
  approach,
  ...constraints,
  ...keyDecisions.map(d => `${d.decision} ${d.reasoning} ${d.alternatives?.join(' ') || ''}`),
  impact.qualitative,
  ...learnings,
  project.body || '',
].join(' ');
const readingTime = formatReadingTime(calculateReadingTime(allText));

const toolsDisplay = techStack.slice(0, 4).join(', ');

// Fetch related projects
const allProjects = await getCollection('projects');
const related = (relatedProjects || [])
  .map(s => allProjects.find(p => p.id === s))
  .filter((p): p is NonNullable<typeof p> => p !== undefined)
  .slice(0, 3);
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - Case Study`}
    description={outcomeSummary}
    type="article"
  />

  <StructuredData
    type="Project"
    data={{
      title,
      outcomeSummary,
      problem,
      impact: impact.qualitative,
      techStack,
      year,
    }}
  />

  <main class="project-page">

    <!-- ── Hero ─────────────────────────────────────────── -->
    <header class="hero">
      <div class="hero-inner">
        <div class="hero-overline">
          <span class="hero-category">{role}</span>
          {status && status !== 'completed' && (
            <span class:list={['status-badge', statusInfo.class]}>
              {statusInfo.label}
            </span>
          )}
        </div>

        <h1 class="hero-title">{title}</h1>

        <p class="hero-description">{outcomeSummary}</p>

        <div class="hero-meta">
          <div class="meta-block">
            <span class="meta-label">Year</span>
            <span class="meta-value">{year}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Role</span>
            <span class="meta-value">{role}</span>
          </div>
          <div class="meta-block">
            <span class="meta-label">Tools</span>
            <span class="meta-value">{toolsDisplay}</span>
          </div>
          {duration && (
            <div class="meta-block">
              <span class="meta-label">Duration</span>
              <span class="meta-value">{duration}</span>
            </div>
          )}
        </div>
      </div>

      {coverImage && (
        <div class="hero-image-wrap">
          <img src={coverImage} alt={title} class="hero-image" loading="eager" />
        </div>
      )}
    </header>

    <!-- ── Body ─────────────────────────────────────────── -->
    <article class="project-body">

      <section class="body-section">
        <p class="lead-paragraph">{overview}</p>
      </section>

      <section class="body-section">
        <h2>The Challenge</h2>
        <p>{problem}</p>
      </section>

      {constraints.length > 0 && (
        <section class="body-section">
          <h2>Constraints</h2>
          <ol class="numbered-list">
            {constraints.map((c) => (
              <li>{c}</li>
            ))}
          </ol>
        </section>
      )}

      <section class="body-section">
        <h2>The Approach</h2>
        <p>{approach}</p>
      </section>

      {keyDecisions.length > 0 && (
        <section class="body-section">
          <h2>Key Decisions</h2>
          <div class="decisions-grid">
            {keyDecisions.map((decision) => (
              <div class="decision-card">
                <h3>{decision.decision}</h3>
                <p>{decision.reasoning}</p>
                {decision.alternatives && decision.alternatives.length > 0 && (
                  <div class="alternatives">
                    <span class="alt-label">Alternatives considered</span>
                    <ul>
                      {decision.alternatives.map((alt) => (
                        <li>{alt}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="body-section">
        <h2>Tech Stack</h2>
        <div class="tech-pills">
          {techStack.map((tech) => (
            <span class="tech-pill">{tech}</span>
          ))}
        </div>
      </section>

      <section class="body-section">
        <h2>Result & Impact</h2>
        {impact.metrics && impact.metrics.length > 0 && (
          <ImpactMetrics metrics={impact.metrics} />
        )}
        <p>{impact.qualitative}</p>
      </section>

      {learnings.length > 0 && (
        <section class="body-section">
          <h2>Learnings</h2>
          <ol class="numbered-list">
            {learnings.map((l) => (
              <li>{l}</li>
            ))}
          </ol>
        </section>
      )}

      {Content && (
        <section class="body-section prose-content">
          <Content />
        </section>
      )}

      <!-- ── Author line ───────────────────────────────── -->
      <div class="author-line">
        <span>by <a href="/">Kanishk Chadha</a></span>
        <span class="reading-time">{readingTime}</span>
      </div>
    </article>

    <!-- ── CTA ──────────────────────────────────────────── -->
    <section class="cta-section">
      <p class="cta-overline">Get in Touch</p>
      <h2 class="cta-heading">Let's Work Together</h2>
      <p class="cta-body">Have a project in mind or just want to say hello? I'd love to hear from you.</p>
      <a href="/contact" class="cta-button">Get in Touch</a>
    </section>

    <!-- ── Related Projects ─────────────────────────────── -->
    {related.length > 0 && (
      <section class="related-section">
        <h2 class="related-heading">More Case Studies</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a href={`/projects/${p.id}`} class="related-card">
              {p.data.coverImage && (
                <img src={p.data.coverImage} alt={p.data.title} class="related-card-img" loading="lazy" />
              )}
              <div class="related-card-body">
                <span class="related-card-meta">{p.data.role} · {p.data.year}</span>
                <h3>{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <a href="/projects" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      All projects
    </a>
  </main>

  <ScrollToTop />
</BaseLayout>

<style>
  /* ── Page shell ───────────────────────────────────────── */
  .project-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) 0;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-overline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: var(--space-md);
  }

  .hero-category {
    font-family: var(--font-family);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-signal-orange);
  }

  .status-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .status--ongoing {
    background: rgba(255, 110, 66, 0.12);
    color: var(--color-signal-orange);
  }

  .status--archived {
    background: rgba(107, 124, 133, 0.12);
    color: var(--color-slate-muted);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0 auto var(--space-2xl);
  }

  .hero-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  /* ── Hero image ────────────────────────────────────────── */
  .hero-image-wrap {
    margin-top: var(--space-2xl);
    border-radius: var(--border-radius-md);
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  /* ── Body ──────────────────────────────────────────────── */
  .project-body {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) 0;
  }

  .body-section {
    margin-bottom: var(--space-3xl);
  }

  .body-section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
  }

  .body-section p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .lead-paragraph {
    font-size: 1.125rem !important;
    line-height: 1.7 !important;
    color: var(--color-text-secondary);
  }

  /* ── Numbered lists ────────────────────────────────────── */
  .numbered-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: item;
  }

  .numbered-list li {
    counter-increment: item;
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .numbered-list li:last-child {
    border-bottom: none;
  }

  .numbered-list li::before {
    content: counter(item) ".";
    font-weight: 700;
    color: var(--color-text);
    flex-shrink: 0;
    min-width: 1.5rem;
  }

  /* ── Decisions ─────────────────────────────────────────── */
  .decisions-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .decision-card {
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
  }

  .decision-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .decision-card p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .alternatives {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .alt-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .alternatives ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .alternatives li {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    padding: 0.25rem 0 0.25rem 1.25rem;
    position: relative;
  }

  .alternatives li::before {
    content: "\2022";
    position: absolute;
    left: 0;
    color: var(--color-signal-orange);
  }

  /* ── Tech pills ────────────────────────────────────────── */
  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 0.5rem 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    color: var(--color-text);
  }

  /* ── Author line ───────────────────────────────────────── */
  .author-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .author-line a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .author-line a:hover {
    color: var(--color-signal-orange);
  }

  .reading-time {
    font-weight: 500;
  }

  /* ── Prose content (markdown body) ─────────────────────── */
  .prose-content :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius-md);
    margin: var(--space-xl) 0 var(--space-sm);
  }

  .prose-content :global(p:has(img)) {
    margin: var(--space-2xl) 0;
  }

  .prose-content :global(em:only-child) {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: normal;
    text-align: center;
    margin-top: -0.5rem;
    margin-bottom: var(--space-xl);
  }

  /* ── CTA section ───────────────────────────────────────── */
  .cta-section {
    max-width: 720px;
    margin: var(--space-4xl) auto 0;
    padding: var(--space-3xl) var(--space-lg);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .cta-overline {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .cta-heading {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .cta-body {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0 auto var(--space-xl);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: var(--border-radius-sm);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .cta-button:hover {
    background: var(--color-oceanic-blue);
    transform: translateY(-1px);
  }

  /* ── Related projects ──────────────────────────────────── */
  .related-section {
    max-width: var(--max-width-content);
    margin: var(--space-4xl) auto 0;
    padding: 0 var(--space-lg);
  }

  .related-heading {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-xl);
    color: var(--color-text);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    background: var(--color-bg-secondary);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .related-card:hover {
    border-color: var(--color-text-muted);
    box-shadow: var(--shadow-md);
  }

  .related-card-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .related-card-body {
    padding: 1.25rem;
  }

  .related-card-meta {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 0.375rem;
  }

  .related-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* ── Back link ─────────────────────────────────────────── */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: var(--max-width-content);
    margin: var(--space-3xl) auto 0;
    padding: 0 var(--space-lg);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-signal-orange);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-2xl) var(--space-md) 0;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .hero-meta {
      flex-wrap: wrap;
      gap: var(--space-lg);
    }

    .hero-image {
      aspect-ratio: 16 / 9;
    }

    .project-body {
      padding: var(--space-2xl) var(--space-md) 0;
    }

    .body-section h2 {
      font-size: 1.5rem;
    }

    .cta-section {
      padding: var(--space-2xl) var(--space-md);
    }

    .cta-heading {
      font-size: 1.75rem;
    }

    .related-section {
      padding: 0 var(--space-md);
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .back-link {
      padding: 0 var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.875rem;
    }

    .hero-meta {
      gap: var(--space-md);
    }

    .meta-block {
      min-width: calc(50% - var(--space-md));
    }
  }
</style>
